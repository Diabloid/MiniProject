<Window x:Class="NovaGames.UI.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Введення" Height="200" Width="400" 
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="ModernGrayButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="20" BorderThickness="0" Background="#333333">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#181818" BorderBrush="#333333" BorderThickness="1" CornerRadius="15" Margin="10" Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtPrompt" Text="Введіть текст:" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBox x:Name="txtInput" Grid.Row="1" Height="40" Background="#252525" Foreground="White" BorderThickness="1" BorderBrush="#00ADEF" VerticalContentAlignment="Center" Padding="10,0" FontSize="14"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="СКАСУВАТИ" Width="100" Height="35" Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click" Margin="0,0,10,0" Style="{StaticResource ModernGrayButtonStyle}"/>
                    <Button Content="ЗБЕРЕГТИ" Width="100" Height="35" Background="#00ADEF" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnOk_Click" Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>
            </Grid>

        </Border>
    </Grid>
</Window>