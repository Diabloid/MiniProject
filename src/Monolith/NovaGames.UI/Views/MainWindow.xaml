<Window x:Class="NovaGames.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        xmlns:helpers="clr-namespace:NovaGames.UI.Helpers"
        Title="Nova Games Store" Height="750" Width="1050"
        MinWidth="1050" MinHeight="750"
        
        Icon="/Assets/LOGO.ico" 
        
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        
        MaxHeight="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}}"
        MaxWidth="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="15" ResizeBorderThickness="15" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogGrayButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="20" Background="#333333">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernGrayButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="20" BorderThickness="0" Background="#333333">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderMenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="10,20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="TopMenu"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="VerticalOffset" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>

                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="5" Padding="10,6" ClipToBounds="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ГОЛОВНИЙ КОНТЕЙНЕР -->
    <Border Background="#1E1E1E" BorderBrush="#333333">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="10"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ТРЕЙ -->
            <tb:TaskbarIcon x:Name="MyNotifyIcon" ToolTipText="NOVA GAMES Store" IconSource="/Assets/LOGO.ico" Visibility="Visible">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                        <MenuItem Header="Відкрити Nova Games" Click="Tray_Restore_Click" FontWeight="Bold" Style="{StaticResource DarkMenuItemStyle}"/>
                        <Separator Style="{StaticResource DarkSeparatorStyle}"/>
                        <MenuItem Header="Вийти" Click="Tray_Exit_Click" Style="{StaticResource DarkMenuItemStyle}"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <!-- ЗАГОЛОВОК (Header) -->
            <Border Grid.Row="0" BorderBrush="#333333" BorderThickness="0,0,0,1" MouseDown="Header_MouseDown" Background="Transparent">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="NOVA" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="GAMES" FontSize="20" FontWeight="Bold" Foreground="#00ADEF" Margin="5,0,30,0" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00ADEF" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Grid x:Name="NavButtonsGrid">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="btnNavStore" Content="МАГАЗИН" Style="{StaticResource HeaderMenuButtonStyle}" Checked="NavMenu_Checked"/>
                                <RadioButton x:Name="btnNavLibrary" Content="БІБЛІОТЕКА" Style="{StaticResource HeaderMenuButtonStyle}" Checked="NavMenu_Checked"/>
                                <RadioButton x:Name="btnNavAdmin" Content="АДМІН ПАНЕЛЬ" Style="{StaticResource HeaderMenuButtonStyle}" Checked="NavMenu_Checked" Visibility="Collapsed"/>
                            </StackPanel>

                            <Border x:Name="SlidingIndicator" Height="3" Background="#00ADEF" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00ADEF" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndicatorTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ПОЛЕ ПОШУКУ -->
                    <Border x:Name="SearchBorder" Grid.Column="1" Background="#252525" CornerRadius="15" Height="35" MaxWidth="400" HorizontalAlignment="Stretch" Margin="20,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="#00ADEF"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00ADEF" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" Foreground="White" 
             TextChanged="TxtSearch_TextChanged" PreviewMouseLeftButtonUp="TxtSearch_PreviewMouseLeftButtonUp"
             VerticalContentAlignment="Center" Padding="35,0,15,0" FontSize="14"
             CaretBrush="White" Style="{StaticResource ModernInputStyle}"/>

                            <TextBlock IsHitTestVisible="False" Text="🔍" Foreground="#888888" FontSize="14" 
               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>

                            <TextBlock IsHitTestVisible="False" Text="Пошук гри..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="35,0,0,0" Foreground="#666666">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBorder}" Placement="Bottom" IsOpen="False" StaysOpen="False" AllowsTransparency="True" VerticalOffset="5">

                        <Grid Width="{Binding ActualWidth, ElementName=SearchBorder}" MaxHeight="300">

                            <Border Background="#1E1E1E" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>

                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" ClipToBounds="True">

                                <ListBox x:Name="listSearchSuggestions" Background="Transparent" BorderThickness="0" 
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="ListSearchSuggestions_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#2A2A2A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border CornerRadius="4" ClipToBounds="True" Height="30" Width="40">
                                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                                           helpers:TextHighlightHelper.HighlightedText="{Binding Title}"
                                                           helpers:TextHighlightHelper.SearchTerm="{Binding Text, ElementName=txtSearch}"/>

                                                <TextBlock Grid.Column="2" Text="{Binding FinalPrice, StringFormat={}{0:N2} ₴}" Foreground="#00ADEF" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Popup>

                    <!-- КНОПКИ КЕРУВАННЯ -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">

                        <Border Background="#252525" CornerRadius="15" Margin="0,0,10,0" Padding="12,6" BorderBrush="#333333" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtBalance" Text="0.00 ₴" Foreground="#AAAAAA" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <Button Content="+" Width="22" Height="22" FontSize="16" FontWeight="Bold" Cursor="Hand" ToolTip="Поповнити рахунок" Click="BtnAddFunds_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="#333333" CornerRadius="11">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#00ADEF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid Width="40" Height="40" Margin="0,0,10,0">

                            <Button x:Name="btnCart" Cursor="Hand" ToolTip="Кошик" Click="BtnCart_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CartBg" Background="#252525" CornerRadius="15" Height="34">
                                                        <TextBlock Text="🛒" FontSize="20" Foreground="#AAAAAA" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="icon"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                                            <Setter TargetName="CartBg" Property="Background" Value="#00ADEF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Border x:Name="badge" Background="#FF5555" CornerRadius="7" Width="14" Height="14" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" 
                                    Visibility="Collapsed" IsHitTestVisible="False">

                                <TextBlock x:Name="txtBadgeCount" Text="1" FontSize="9" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>

                        </Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0">

                            <Border x:Name="HeaderAvatarBorder" Width="30" Height="30" CornerRadius="15" Background="#2A2A2A" BorderBrush="#00ADEF" BorderThickness="1" Margin="0,0,10,0">
                                <Grid>
                                    <TextBlock x:Name="txtHeaderAvatarLetter" Text="?" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>

                                    <Image x:Name="imgHeaderAvatar" Width="28" Height="28" Stretch="UniformToFill" Visibility="Collapsed">
                                        <Image.Clip>
                                            <EllipseGeometry RadiusX="14" RadiusY="14" Center="14,14"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <Button x:Name="btnUserProfile" Content="Username" FontSize="15" FontWeight="Bold" Foreground="#00ADEF" Cursor="Hand" ToolTip="Налаштування профілю" Click="BtnUserProfile_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent" VerticalAlignment="Center"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="BtnMinimize_Click"/>
                        <Button x:Name="btnMaximize" Content="☐" Style="{StaticResource WindowButtonStyle}" Click="BtnMaximize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowButtonStyle}" Click="BtnClose_Click" Foreground="#FF5555"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="#121212">
                <ContentControl x:Name="MainContent" Margin="0"/>
            </Grid>

            <Grid x:Name="OverlayWallet" Visibility="Collapsed" Panel.ZIndex="999" Grid.Row="0" Grid.RowSpan="5" Grid.ColumnSpan="5">
                <Border Background="#99000000" MouseLeftButtonDown="OverlayWallet_Close_Click"/>

                <Grid Width="450" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#181818" BorderBrush="#333333" BorderThickness="1" CornerRadius="15" Margin="10">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.6"/>
                        </Border.Effect>

                        <Grid Margin="25">

                            <StackPanel x:Name="PanelStep1_Amount" Visibility="Visible">
                                <TextBlock Text="ПОПОВНЕННЯ ГАМАНЦЯ" Foreground="#00ADEF" FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,15" Height="25"/>
                                <TextBlock Text="Введіть або виберіть суму (₴):" Foreground="White" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,15"/>

                                <UniformGrid Columns="3" Height="40" Margin="0,0,0,15">
                                    <Button Content="100 ₴" Margin="0,0,10,0" Style="{StaticResource DialogGrayButtonStyle}" Click="BtnQuickAmount_Click" Tag="100"/>
                                    <Button Content="500 ₴" Margin="0,0,10,0" Style="{StaticResource DialogGrayButtonStyle}" Click="BtnQuickAmount_Click" Tag="500"/>
                                    <Button Content="1000 ₴" Margin="0,0,0,0" Style="{StaticResource DialogGrayButtonStyle}" Click="BtnQuickAmount_Click" Tag="1000"/>
                                </UniformGrid>

                                <Border Background="#252525" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Height="50" Margin="0,0,0,25">
                                    <Grid>
                                        <TextBlock Text="₴" Foreground="#00ADEF" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                        <TextBox x:Name="txtReplenishAmount" Background="Transparent" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" VerticalContentAlignment="Center" Margin="35,0,15,0" Text="500" PreviewTextInput="TxtAmount_PreviewTextInput"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Оплата через банківську картку." Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                                <Button Content="ДАЛІ" Style="{StaticResource ModernButtonStyle}" Height="40" FontSize="14" FontWeight="Bold" Click="BtnConfirmReplenish_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelStep2_Payment" Visibility="Collapsed">
                                <TextBlock Text="ОПЛАТА КАРТКОЮ" Foreground="#00ADEF" FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                                <StackPanel x:Name="PanelSavedCards" Visibility="Collapsed" Margin="0,0,0,15">
                                    <TextBlock Text="Збережені картки" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="comboSavedCards" Style="{StaticResource ModernComboBoxStyle}" Height="45" FontSize="16" SelectionChanged="ComboSavedCards_SelectionChanged" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>

                                    <TextBlock Text="або введіть нову:" Foreground="#666666" FontSize="12" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                </StackPanel>

                                <TextBlock Text="Номер картки" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                                <Border Background="#252525" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Height="45" Margin="0,0,0,15">
                                    <TextBox x:Name="txtCardNumber" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" VerticalContentAlignment="Center" Margin="10,0" MaxLength="16" PreviewTextInput="TxtAmount_PreviewTextInput"/>
                                </Border>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Термін дії (ММ/РР)" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                                        <Border Background="#252525" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Height="45">
                                            <TextBox x:Name="txtCardExpiry" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="5" PreviewTextInput="TxtAmount_PreviewTextInput" TextChanged="TxtCardExpiry_TextChanged"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CVV" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                                        <Border Background="#252525" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Height="45">
                                            <TextBox x:Name="txtCardCvv" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="3" PreviewTextInput="TxtAmount_PreviewTextInput"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="chkSaveCard" Content="Запам'ятати цю картку для майбутніх покупок" Style="{StaticResource NovaCheckBoxStyle}" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,25"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="НАЗАД" Width="100" Style="{StaticResource DialogGrayButtonStyle}" Height="40" Margin="0,0,10,0" Click="BtnBackToAmount_Click"/>
                                    <Button Grid.Column="1" x:Name="btnProcessPayment" Content="ОПЛАТИТИ" Style="{StaticResource ModernButtonStyle}" Height="40" FontSize="14" FontWeight="Bold" Click="BtnProcessPayment_Click"/>
                                </Grid>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <Button Style="{StaticResource CloseButtonStyle}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Click="OverlayWallet_Close_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>