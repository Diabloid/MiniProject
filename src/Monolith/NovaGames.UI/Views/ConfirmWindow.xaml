<Window x:Class="NovaGames.UI.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підтвердження" Height="250" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="DialogRedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="20" Background="#FF5555">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF5555" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogGrayButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="20" Background="#333333">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>



    <Grid>
        <Border Background="#181818" BorderBrush="#333333" BorderThickness="1" CornerRadius="15" Margin="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="txtHeader" Text="ПІДТВЕРДЖЕННЯ" Foreground="#FF5555" FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,15" Height="39"/>

                <TextBlock x:Name="txtMessage" Text="Повідомлення" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock x:Name="txtWarning" Text="Попередження." Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnCancel" Content="СКАСУВАТИ" Grid.Column="0" Height="40" Style="{StaticResource DialogGrayButtonStyle}" Click="BtnCancel_Click" Margin="10"/>

                    <Button x:Name="btnConfirm" Content="ПІДТВЕРДИТИ" Grid.Column="2" Height="40" Style="{StaticResource DialogRedButtonStyle}" Click="BtnConfirm_Click" Margin="10"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>