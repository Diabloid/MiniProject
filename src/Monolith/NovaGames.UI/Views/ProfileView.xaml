<UserControl x:Class="NovaGames.UI.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ModernRedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="20" BorderThickness="0" Background="#FF5555">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF5555" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,10,15"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#00ADEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#121212" ClipToBounds="True">
        <Border HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="1100" 
                Background="#1A1A1A" BorderBrush="#00ADEF" BorderThickness="2,0,2,0">
            <Border.Effect>
                <DropShadowEffect Color="#00ADEF" BlurRadius="40" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Rectangle Height="12" VerticalAlignment="Top" Panel.ZIndex="100" Margin="-2,0,-2,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#AA000000" Offset="0"/>
                            <GradientStop Color="#44000000" Offset="0.4"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,2">
                        <Grid x:Name="ProfileNavGrid" Margin="30,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbSettings" Content="НАЛАШТУВАННЯ" Style="{StaticResource ProfileTabStyle}" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="rbSubs" Content="ПІДПИСКИ" Style="{StaticResource ProfileTabStyle}" Checked="Tab_Checked"/>
                                <RadioButton x:Name="rbPurchases" Content="МОЇ ПОКУПКИ" Style="{StaticResource ProfileTabStyle}" Checked="Tab_Checked"/>
                            </StackPanel>
                            <Border x:Name="ProfileIndicator" Height="3" Background="#00ADEF" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00ADEF" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ProfileIndicatorTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="SettingsContentGrid" Grid.Row="1" Visibility="Visible">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="60,40">
                            <StackPanel MaxWidth="800" HorizontalAlignment="Left">

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                                    <Border x:Name="ProfileAvatarCircle" Width="100" Height="100" CornerRadius="50" BorderBrush="#00ADEF" BorderThickness="3">
                                        <Grid>
                                            <Ellipse Fill="#252525"/>

                                            <TextBlock x:Name="txtProfileAvatarLetter" Text="?" FontSize="45" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/>

                                            <Image x:Name="imgProfileAvatar" Width="94" Height="94" Stretch="UniformToFill" Visibility="Collapsed">
                                                <Image.Clip>
                                                    <EllipseGeometry RadiusX="47" RadiusY="47" Center="47,47"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="30,0,0,0">
                                        <TextBlock x:Name="txtUsernameLabel" Text="Username" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtBalanceLabel" Text="Баланс: 0.00 ₴" Foreground="#00ADEF" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="ПЕРСОНАЛІЗАЦІЯ" Foreground="#666666" FontSize="11" FontWeight="Bold" Margin="5,0,0,15"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                                    <Button Content="ЗМІНИТИ АВАТАРКУ" Width="180" Height="40" Style="{StaticResource ModernButtonStyle}" Click="BtnChangeAvatar_Click"/>

                                    <TextBlock Text="КОЛІР ОБВЕДЕННЯ:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="30,0,15,0" FontSize="12" FontWeight="Bold"/>

                                    <StackPanel x:Name="ColorPresetsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <Rectangle Width="26" Height="26" Fill="#00ADEF" RadiusX="13" RadiusY="13" Cursor="Hand" Margin="0,0,8,0" MouseLeftButtonDown="ColorPreset_Click" Tag="#00ADEF" Stroke="White" StrokeThickness="1"/>
                                        <Rectangle Width="26" Height="26" Fill="#FF5555" RadiusX="13" RadiusY="13" Cursor="Hand" Margin="0,0,8,0" MouseLeftButtonDown="ColorPreset_Click" Tag="#FF5555" StrokeThickness="0"/>
                                        <Rectangle Width="26" Height="26" Fill="#00D26A" RadiusX="13" RadiusY="13" Cursor="Hand" Margin="0,0,8,0" MouseLeftButtonDown="ColorPreset_Click" Tag="#00D26A" StrokeThickness="0"/>
                                        <Rectangle Width="26" Height="26" Fill="#FFB900" RadiusX="13" RadiusY="13" Cursor="Hand" Margin="0,0,8,0" MouseLeftButtonDown="ColorPreset_Click" Tag="#FFB900" StrokeThickness="0"/>
                                        <Rectangle Width="26" Height="26" Fill="#9D00FF" RadiusX="13" RadiusY="13" Cursor="Hand" MouseLeftButtonDown="ColorPreset_Click" Tag="#9D00FF" StrokeThickness="0"/>
                                    </StackPanel>

                                    <TextBox x:Name="txtHexColor" Width="80" Height="30" Text="#00ADEF" Foreground="White" Background="#2A2A2A" BorderBrush="#333333" BorderThickness="1" Padding="5" VerticalAlignment="Center" TextChanged="TxtHexColor_TextChanged"/>
                                </StackPanel>
                                <TextBlock Text="АКАУНТ ТА БЕЗПЕКА" Foreground="#666666" FontSize="11" FontWeight="Bold" Margin="5,0,0,20"/>

                                <TextBlock Text="ЕЛЕКТРОННА ПОШТА" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBox x:Name="txtProfileEmail" Width="400" Height="40" Style="{StaticResource ModernInputStyle}" TextChanged="TxtProfileEmail_TextChanged"/>
                                    <TextBlock x:Name="iconEmailVerified" Text="✔️" Foreground="#00D26A" FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" ToolTip="Пошта підтверджена"/>
                                    <TextBlock x:Name="txtEmailError" Text="Така пошта вже прив'язана!" Foreground="#FF5555" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel x:Name="panelVerificationCode" Visibility="Collapsed" Width="400" HorizontalAlignment="Left" Margin="0,0,0,15">
                                    <TextBlock Text="КОД ПІДТВЕРДЖЕННЯ З ЛИСТА" Foreground="#00ADEF" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                                    <TextBox x:Name="txtVerificationCode" Height="40" Style="{StaticResource ModernInputStyle}" TextChanged="TxtVerificationCode_TextChanged"/>
                                </StackPanel>

                                <Button x:Name="btnBindEmail" Content="ПРИВ'ЯЗАТИ ПОШТУ" Width="220" Height="35" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,30" Click="BtnBindEmail_Click"/>

                                <TextBlock Text="НОВИЙ ПАРОЛЬ" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <PasswordBox x:Name="txtProfilePass" Width="400" Height="40" Style="{StaticResource ModernInputStyle}" PasswordChanged="TxtProfilePass_PasswordChanged"/>
                                    <TextBlock x:Name="txtPasswordMessage" Text="Потрібна прив'язана пошта!" Foreground="#FF5555" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel x:Name="panelPasswordCode" Visibility="Collapsed" Width="400" HorizontalAlignment="Left" Margin="0,0,0,15">
                                    <TextBlock Text="КОД ПІДТВЕРДЖЕННЯ З ЛИСТА" Foreground="#00ADEF" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                                    <TextBox x:Name="txtPasswordVerificationCode" Height="40" Style="{StaticResource ModernInputStyle}" TextChanged="TxtPasswordVerificationCode_TextChanged"/>
                                </StackPanel>

                                <Button x:Name="btnUpdatePassword" Content="ОНОВИТИ ПАРОЛЬ" Width="180" Height="35" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,30" Click="BtnUpdatePassword_Click"/>

                                <Separator Background="#333333" Margin="0,10,0,30"/>

                                <TextBlock Text="ДЕТАЛІ ДОСТАВКИ" Foreground="#666666" FontSize="11" FontWeight="Bold" Margin="5,0,0,20"/>
                                <UniformGrid Columns="2" Margin="0,0,0,15" Width="400" HorizontalAlignment="Left">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="МІСТО" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                                        <TextBox x:Name="txtCity" Height="40" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="ПОШТОВИЙ ІНДЕКС" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                                        <TextBox x:Name="txtZip" Height="40" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="НОМЕР ТЕЛЕФОНУ" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="5,0,0,5"/>
                                <TextBox x:Name="txtPhone" Height="40" Margin="0,0,0,40" Width="400" HorizontalAlignment="Left"/>

                                <Button Content="ВИЙТИ З АКАУНТА" Width="200" Height="45" Style="{StaticResource ModernRedButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,50" Click="BtnLogout_Click"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <ContentControl x:Name="DynamicTabContent" Grid.Row="1" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>