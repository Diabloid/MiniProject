<UserControl x:Class="NovaGames.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NovaGames.UI.Converters"
             Background="#121212">

    <UserControl.Resources>
        <conv:AvatarConverter x:Key="AvatarConverter"/>
        <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <conv:FirstLetterConverter x:Key="FirstLetterConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="LibraryToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="#333333">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00ADEF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00ADEF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,2,10,2"/>

            <EventSetter Event="ContextMenuOpening" Handler="GameItem_ContextMenuOpening"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A00ADEF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00ADEF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1A00ADEF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00ADEF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryExpanderStyle" TargetType="Expander">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#00ADEF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="headerBorder" Background="Transparent" Padding="5,5,10,5">
                                            <Border.ContextMenu>
                                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                                    <MenuItem Header="Перейменувати категорію" 
                                                              Style="{StaticResource DarkMenuItemStyle}" 
                                                              Click="RenameCategory_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Path x:Name="Arrow" Stroke="#00ADEF" StrokeThickness="2" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Data="M 2,0 L 6,4 L 2,8" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>

                                                <ContentPresenter Grid.Column="1" Margin="5,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M 0,3 L 4,7 L 8,3"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter TargetName="headerBorder" Property="Background" Value="#252525"/>
                                                <Setter TargetName="headerBorder" Property="CornerRadius" Value="4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </ToggleButton>

                            <ContentPresenter x:Name="Content" Visibility="Collapsed" Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Content" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="240"/>

            <Setter Property="Background" Value="#00ADEF"/>
            <Setter Property="Tag" Value="#00ADEF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="25" BorderThickness="0" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                                  BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <DataTrigger Binding="{Binding CurrentInstallState}" Value="Downloading">
                                <Setter Property="Background" Value="#F39C12"/>
                                <Setter Property="Tag" Value="#F39C12"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentInstallState}" Value="ReadyToPlay">
                                <Setter Property="Background" Value="#2ECC71"/>
                                <Setter Property="Tag" Value="#2ECC71"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentInstallState}" Value="Running">
                                <Setter Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentInstallState}" Value="UpdateAvailable">
                                <Setter Property="Background" Value="#9B59B6"/>
                                <Setter Property="Tag" Value="#9B59B6"/>
                            </DataTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для зірочок рейтингу -->
        <Style x:Key="StarRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFB900"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#181818" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <Grid Margin="15,20,15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="БІБЛІОТЕКА" Foreground="White" FontSize="22" FontWeight="ExtraBold" Margin="0,0,0,15"/>

                <Border Grid.Row="1" Background="#252525" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Height="40" Margin="0,0,0,15">
                    <Grid>
                        <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" Foreground="White" TextChanged="TxtSearch_TextChanged"
                                 VerticalContentAlignment="Center" Padding="15,0" FontSize="14" CaretBrush="White"/>

                        <TextBlock IsHitTestVisible="False" Text="Пошук гри..." VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#666666">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,0,0,0">

                    <ToggleButton x:Name="btnFilterInstalled" Content="ТІЛЬКИ ВСТАНОВЛЕНІ" Style="{StaticResource LibraryToggleButtonStyle}" Height="35" Margin="0,0,0,15" Checked="BtnFilterInstalled_Changed" Unchecked="BtnFilterInstalled_Changed"/>

                    <TextBlock Text="Сортувати за" Foreground="#666666" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="comboSort" Height="35" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="ComboSort_SelectionChanged" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}">
                        <ComboBoxItem Content="Останні зіграні" IsSelected="True"/>
                        <ComboBoxItem Content="Назвою (А-Я)"/>
                        <ComboBoxItem Content="Назвою (Я-А)"/>
                        <ComboBoxItem Content="Розміром (від більшого)"/>
                        <ComboBoxItem Content="Датою придбання"/>
                    </ComboBox>
                    <Separator Background="#333333" Margin="0,10"/>
                </StackPanel>

                <ListBox x:Name="listLibraryGames" Grid.Row="3" Background="Transparent" BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource LibraryItemStyle}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="24" Height="24" CornerRadius="4" Background="#333333" HorizontalAlignment="Left">
                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander Style="{StaticResource LibraryExpanderStyle}" IsExpanded="True" Background="Transparent" BorderThickness="0" Margin="0,5,0,10">
                                                    <Expander.Header>
                                                        <TextBlock Text="{Binding Name}" Foreground="#00ADEF" FontWeight="Bold" FontSize="13" Margin="0,5"/>
                                                    </Expander.Header>
                                                    <ItemsPresenter Margin="10,5,0,0"/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" x:Name="panelGameDetails" Background="#121212">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Виберіть гру зі списку" Foreground="#666666" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Щоб почати грати або встановити її на ПК" Foreground="#444444" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Grid Height="450" ClipToBounds="True">

                        <Image Source="{Binding SelectedGame.HeroImageUrl}" 
                               Stretch="UniformToFill" 
                               Margin="0,-80,0,0"/>

                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00121212" Offset="0.3"/>
                                    <GradientStop Color="#EE121212" Offset="0.8"/>
                                    <GradientStop Color="#121212" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="{Binding SelectedGame.Title}" 
                                   Foreground="White" FontSize="48" FontWeight="ExtraBold" 
                                   VerticalAlignment="Bottom" Margin="40,0,0,20">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="40,10,40,30" VerticalAlignment="Center">

                        <Button Content="{Binding ActionButtonText}" 
                                Command="{Binding ActionCommand}"
                                Style="{StaticResource LibraryActionButtonStyle}"/>

                        <Grid Width="260" VerticalAlignment="Center" Margin="30,0,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentInstallState}" Value="Downloading">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DownloadStatusText}" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding DownloadPercentage, StringFormat={}{0}%}" Foreground="#F39C12" FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercentage}" Height="8" BorderThickness="0">
                                    <ProgressBar.Foreground>
                                        <SolidColorBrush Color="#F39C12"/>
                                    </ProgressBar.Foreground>
                                    <ProgressBar.Background>
                                        <SolidColorBrush Color="#252525"/>
                                    </ProgressBar.Background>
                                </ProgressBar>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="ОСТАННІЙ ЗАПУСК" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SelectedGame.LastPlayedDate}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="ЧАС У ГРІ" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SelectedGame.DisplayPlaytime}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Click="BtnGoToStore_Click" 
                Cursor="Hand" 
                Background="Transparent" 
                BorderThickness="0" 
                Margin="40,0,0,5" 
                VerticalAlignment="Bottom">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="txtStoreLink" 
                               Text="СТОРІНКА ГРИ ➔" 
                               Foreground="White" 
                               FontSize="14" 
                               FontWeight="SemiBold"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="txtStoreLink" Property="Foreground" Value="#00ADEF"/>
                                            <!-- Додаємо підкреслення при наведенні, щоб 100% було зрозуміло, що це лінк -->
                                            <Setter TargetName="txtStoreLink" Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>

                    <Separator Background="#252525" Margin="40,0"/>

                    <StackPanel Margin="40,30,40,40">
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="ВІДГУКИ ГРАВЦІВ" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReviewsList.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="★" Foreground="#FFB900" FontSize="20" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CurrentAverageRating}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ReviewsList.Count, StringFormat={} ({0} відгуків)}" Foreground="#888888" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="WriteReviewPanel" Background="#1A1A1A" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,25">
                            <StackPanel>
                                <TextBlock Text="НАПИСАТИ ВІДГУК" Foreground="#00ADEF" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="Ваша оцінка:" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <RadioButton x:Name="star1" Content="★" GroupName="Rating" Style="{StaticResource StarRadioButtonStyle}" Tag="1" Checked="Star_Checked" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave"/>
                                    <RadioButton x:Name="star2" Content="★" GroupName="Rating" Style="{StaticResource StarRadioButtonStyle}" Tag="2" Checked="Star_Checked" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave"/>
                                    <RadioButton x:Name="star3" Content="★" GroupName="Rating" Style="{StaticResource StarRadioButtonStyle}" Tag="3" Checked="Star_Checked" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave"/>
                                    <RadioButton x:Name="star4" Content="★" GroupName="Rating" Style="{StaticResource StarRadioButtonStyle}" Tag="4" Checked="Star_Checked" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave"/>
                                    <RadioButton x:Name="star5" Content="★" GroupName="Rating" Style="{StaticResource StarRadioButtonStyle}" Tag="5" Checked="Star_Checked" MouseEnter="Star_MouseEnter" MouseLeave="Star_MouseLeave"/>
                                </StackPanel>

                                <TextBox x:Name="txtReviewInput" MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" 
                                         VerticalContentAlignment="Top" Padding="12,12,10,12" 
                                         ToolTip="Розкажіть іншим гравцям про ваші враження від гри..."/>

                                <Button x:Name="btnSubmitReview" Content="ВІДПРАВИТИ" Width="150" Height="35" 
                                        HorizontalAlignment="Right" Margin="0,15,0,0" 
                                        Style="{StaticResource ModernButtonStyle}" Click="BtnSubmitReview_Click"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="listReviews" ItemsSource="{Binding ReviewsList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#252525" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="20" Background="#2A2A2A" 
                                                    BorderBrush="{Binding AvatarBorderColorHex, Converter={StaticResource HexToBrushConverter}}" 
                                                    BorderThickness="2" VerticalAlignment="Top">
                                                <Grid>
                                                    <TextBlock Text="{Binding Username, Converter={StaticResource FirstLetterConverter}}" 
                                                                Foreground="White" FontSize="18" FontWeight="Bold" 
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>

                                                    <Image Source="{Binding AvatarUrl, Converter={StaticResource AvatarConverter}}" Stretch="UniformToFill">
                                                        <Image.Clip>
                                                            <EllipseGeometry RadiusX="18" RadiusY="18" Center="18,18"/>
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Username}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                    <TextBlock Grid.Column="1" Text="(змінено)" Foreground="#888888" FontSize="11" VerticalAlignment="Bottom" Margin="5,0,0,1" 
                                                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Tag="{Binding}" Click="BtnEditReview_Click" 
                                                                Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}"
                                                                Cursor="Hand" Margin="0,0,10,0" Background="Transparent" BorderThickness="0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <TextBlock x:Name="txtBtn" Text="✎ Редагувати" Foreground="#00ADEF" FontSize="12"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="txtBtn" Property="Foreground" Value="#55C8F5"/>
                                                                            <Setter TargetName="txtBtn" Property="TextDecorations" Value="Underline"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Tag="{Binding}" Click="BtnDeleteReview_Click" 
                                                                Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}"
                                                                Cursor="Hand" Margin="0,0,15,0" Background="Transparent" BorderThickness="0">           
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <TextBlock x:Name="txtBtnDel" Text="✖ Видалити" Foreground="#FF5555" FontSize="12"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="txtBtnDel" Property="Foreground" Value="#FF7777"/>
                                                                            <Setter TargetName="txtBtnDel" Property="TextDecorations" Value="Underline"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}" Foreground="#666666" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding Rating, StringFormat={}Оцінка: {0} з 5}" Foreground="#FFB900" FontSize="12" FontWeight="Bold" Margin="0,5,0,10"/>

                                                <TextBlock Text="{Binding Text}" Foreground="#CCCCCC" FontSize="14" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>